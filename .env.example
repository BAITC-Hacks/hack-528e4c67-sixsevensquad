# Скопируйте в .env только при первой установке. Настоящие ключи сюда не добавляйте.
KONTUR_STORAGE=memory
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MONGODB_URI=
MONGODB_DATABASE=kontur
KONTUR_MAX_CHARS=250000
KONTUR_MAX_CALLS=80
# Ограничения одного проекта, включая повторные попытки:
KONTUR_BUDGET_USD=0.50
KONTUR_REQUEST_TIMEOUT=75
KONTUR_ANALYSIS_SECONDS=600
KONTUR_MAX_OUTPUT_TOKENS=6000
# Альтернатива Atlas: KONTUR_STORAGE=local сохраняет проекты в runtime/projects.
